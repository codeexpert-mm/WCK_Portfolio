# Copy to .env.local and fill in. All values are examples, not real secrets.

# ── Email (contact form + notifications) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_app_password
CONTACT_EMAIL=you@example.com
# Optional: send an auto-reply to people who use the contact form
SEND_AUTO_REPLY=false

# ── Database (portfolio rating system, Prisma Accelerate) ───────────────
PRISMA_DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=your_key
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Analytics ────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── GitHub (projects section) ────────────────────────────────────────────
# OPTIONAL. The site works without it: /api/projects proxies GitHub with
# server-side caching (60 req/h unauthenticated quota, shared via cache).
# Add a fine-grained read-only token to raise the server quota to 5,000/h.
# Server-only — never prefix with NEXT_PUBLIC_.
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxx

# ── Freepik / Magnific (Experience illustrations + /api/freepik/search) ──
# OPTIONAL. Curated illustrations already ship in public/experience.
# Get a key at https://www.freepik.com/api (Magnific-branded Freepik API:
# https://www.magnific.com) to enable live search via GET /api/freepik/search
# and `npm run freepik:experience`. Server-only — never NEXT_PUBLIC_.
# FREEPIK_API_KEY=your_freepik_api_key
# MAGNIFIC_API_KEY=your_magnific_api_key
